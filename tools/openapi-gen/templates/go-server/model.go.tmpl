{{- /* Emit a single struct file with all models */ -}}
{{- if .Models}}
--- struct.gen.go
{{template "header" .}}
package {{$.Var "package" ""}}

{{- /* A --namespace-only (TypeSpec) run has no x-package, only current_package. */}}
{{- $currentPkg := $.Var "x-package" ($.Var "current_package" "") -}}
{{- $basePkg := $.Var "base_package" "api" -}}
{{- $extPkgs := dict}}
{{- range $model := .Models}}
{{- /* Check each property for external type references */}}
{{- range $propName := propertyNamesOrdered $model.SchemaName $model.Schema}}
{{- $prop := getProperty $model.Schema $propName}}
{{- if $prop}}
{{- $typePkg := getTypePackage $prop}}
{{- if and $typePkg (ne $typePkg $currentPkg)}}
{{- $_ := set $extPkgs $typePkg true}}
{{- end}}
{{- end}}
{{- end}}
{{- end}}

import (
	"encoding/json/jsontext"
	json "encoding/json/v2"
	"time"
{{- if $extPkgs}}

{{- range $pkg, $_ := $extPkgs}}
	{{$pkg}}v1 "{{$basePkg}}/{{$pkg}}/v1"
{{- end}}
{{- end}}
)

// Ensure imports are used.
var (
	_ time.Time
)

{{- range $model := .Models}}

{{- if $model.Schema.Enum}}
{{template "model_enum" $model}}
{{- else}}
{{template "model_simple" (dict "Model" $model "CurrentPkg" $currentPkg)}}
{{- end}}
{{- end}}
{{- end}}
