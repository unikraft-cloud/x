{{define "model_simple" -}}
{{- $schema := .Schema -}}
{{- $schemaName := .SchemaName -}}
{{- $currentPkg := .Package -}}
{{- $propNames := propertyNamesOrdered $schemaName $schema -}}
{{- if $schema.Description}}
// {{$schema.Description | replace "\n" "\n// "}}
{{- end}}
type {{$schemaName}} struct {
{{- range $propName := propertyNamesOrdered $schemaName $schema}}
{{- $prop := getProperty $schema $propName}}
{{- if $prop}}
{{- if $prop.Description}}
	// {{$prop.Description | replace "\n" "\n\t// "}}
{{- end}}
{{- $required := getPropertyRequired $schema $propName}}
{{- $propGoName := pascalcase $propName}}
{{- $openAPIType := getType $prop}}
{{- $rawType := schemaToGoType $prop}}
{{- $typePkg := getTypePackage $prop}}
{{- $propType := $rawType}}
{{- if and $typePkg (ne $typePkg $currentPkg)}}
{{- $propType = regexReplaceAll "([A-Z]\\w+)$" $rawType (printf "%sv1.${1}" $typePkg)}}
{{- end}}
{{- if not $required}}
	{{- if and (ne $openAPIType "array") (ne $openAPIType "object")}}
		{{- if and $typePkg (ne $typePkg $currentPkg)}}
		{{- $propType = printf "*%s" (regexReplaceAll "([A-Z]\\w+)$" $rawType (printf "%sv1.${1}" $typePkg))}}
		{{- else}}
		{{- $propType = printf "*%s" $rawType}}
		{{- end}}
	{{- end}}
{{- end}}
{{- if $required}}
	{{$propGoName}} {{$propType}} `json:"{{$propName}}" yaml:"{{$propName}}"`
{{- else}}
	{{$propGoName}} {{$propType}} `json:"{{$propName}},omitzero" yaml:"{{$propName}},omitempty"`
{{- end}}
{{- end}}
{{- end}}

	// AdditionalProperties captures any JSON object members that do not map to
	// an explicit field above.
	AdditionalProperties map[string]jsontext.Value `json:",embed" yaml:"-"`
}

// UnmarshalJSON delegates to encoding/json/v2 so that AdditionalProperties
// (tagged `json:",embed"`) is populated with any unknown object members.
func (m *{{$schemaName}}) UnmarshalJSON(data []byte) error {
	type Alias {{$schemaName}}
	return json.Unmarshal(data, (*Alias)(m))
}

// MarshalJSON delegates to encoding/json/v2 so that AdditionalProperties
// (tagged `json:",embed"`) is flattened into the parent JSON object.
func (m {{$schemaName}}) MarshalJSON() ([]byte, error) {
	type Alias {{$schemaName}}
	return json.Marshal((Alias)(m))
}
{{- end}}
