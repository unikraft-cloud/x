{{- /* Only emitted when response_envelope=true and response_package is unset
   (see gin.go.tmpl); response_package imports Response[T] from elsewhere instead. */ -}}
{{- $responsePackage := $.Var "response_package" "" -}}
{{- $wrapResponse := or (eq ($.Var "response_envelope" "false") "true") (ne $responsePackage "") -}}
{{- if and $wrapResponse (eq $responsePackage "") }}
{{- /* ResponseStatus/ResponseError are fallback types: if the schema already
   declares its own model of that name (e.g. the platform spec), skip the
   duplicate here and reuse the schema-generated one instead. */ -}}
{{- $hasResponseStatus := false -}}
{{- $hasResponseError := false -}}
{{- range .Models -}}
{{- if eq .SchemaName "ResponseStatus" -}}{{- $hasResponseStatus = true -}}{{- end -}}
{{- if eq .SchemaName "ResponseError" -}}{{- $hasResponseError = true -}}{{- end -}}
{{- end }}
--- response.gen.go
// Code generated by unikraft.com/x/tools/openapi-gen. DO NOT EDIT.

package {{ .Var "package" "client" }}

// Response is the standard response envelope.
type Response[T any] struct {
	Status   ResponseStatus  `json:"status,omitempty"`
	Message  string          `json:"message,omitempty"`
	Errors   []ResponseError `json:"errors,omitempty"`
	Data     *T              `json:"data,omitempty"`
	OpTimeUs uint64          `json:"op_time_us,omitempty"`
}
{{ if not $hasResponseStatus }}
// ResponseStatus is the top-level status of a Response.
type ResponseStatus string

const (
	ResponseStatusSuccess        ResponseStatus = "success"
	ResponseStatusPartialSuccess ResponseStatus = "partial_success"
	ResponseStatusError          ResponseStatus = "error"
)
{{ end -}}
{{ if not $hasResponseError }}
// ResponseError describes a single error that occurred while processing a request.
type ResponseError struct {
	Status uint64 `json:"status"`
}
{{- end }}
{{- end }}
